diff --git a/CMakeLists.txt b/CMakeLists.txt
index 5420ecc..8c74f28 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -21,7 +21,7 @@ include(cmake/ConfigureOpenSSL.cmake)
 include(cmake/DetectTargetPlatform.cmake)
 include(cmake/FetchOpenSSL.cmake)
 include(cmake/FindVcvarsall.cmake)
-include(cmake/GetCPM.cmake)
+#include(cmake/GetCPM.cmake)
 
 # Custom options
 option(OPENSSL_BUILD_VERBOSE "Enable verbose output from build" OFF)
@@ -31,7 +31,7 @@ option(OPENSSL_INSTALL "Install OpenSSL components to the <prefix> directory" OF
 option(OPENSSL_INSTALL_CERT "Install cert.pem to the <openssldir> directory" OFF)
 option(OPENSSL_TEST "Enable testing and build OpenSSL self tests" OFF)
 option(OPENSSL_USE_CCACHE "Use ccache if available" ON)
-
+option(OPENSSL_NO_ASM "Disable asm" ON)
 if("${OPENSSL_BUILD_TARGET}" STREQUAL "")
     # Makefile target for build
     set(OPENSSL_BUILD_TARGET build_libs)
@@ -46,6 +46,21 @@ if("${OPENSSL_TARGET_PLATFORM}" STREQUAL "")
     # Use OpenSSL's Configure target
     detect_target_platform(OPENSSL_TARGET_PLATFORM)
 endif()
+if (OPENSSL_NO_ASM)
+    list(APPEND OPENSSL_CONFIGURE_OPTIONS no-asm)
+endif()
+# Fetch OpenSSL source
+find_package(Git REQUIRED)
+if (NOT IS_DIRECTORY ${CMAKE_SOURCE_DIR}/openssl)
+    execute_process(COMMAND ${GIT_EXECUTABLE} clone -b openssl-${OPENSSL_TARGET_VERSION} --depth 1 https://github.com/openssl/openssl.git openssl WORKING_DIRECTORY ${CMAKE_SOURCE_DIR})
+else ()
+    execute_process(COMMAND ${GIT_EXECUTABLE} tag WORKING_DIRECTORY ${CMAKE_SOURCE_DIR}/openssl OUTPUT_VARIABLE head_rev ERROR_QUIET)
+    string(STRIP ${head_rev} head_rev)
+    if(NOT ${head_rev} MATCHES openssl-${OPENSSL_TARGET_VERSION})
+        file(REMOVE_RECURSE ${CMAKE_SOURCE_DIR}/openssl)
+        execute_process(COMMAND ${GIT_EXECUTABLE} clone -b openssl-${OPENSSL_TARGET_VERSION} --depth 1 https://github.com/openssl/openssl.git openssl WORKING_DIRECTORY ${CMAKE_SOURCE_DIR})
+    endif ()
+endif ()
 
 # Fetch OpenSSL source
 fetch_openssl()
