// created by Andrey Vasiliev

import StdQuad from stdquad.material

fragment_program fx_fp glsl glsles vk
{
    source fx.frag
	default_params
	{
		param_named_auto Time time
		param_named VignetteParams float4 1 1 1 0
		param_named VignetteColor float3 0 0 0
	}
}

material Fx : StdQuad
{
	technique
	{
		pass
		{
            fragment_program_ref fx_fp
			{
                param_named RT int 0
				param_named LUT int 1
			}

			texture_unit LUT
            {
                texture lut.png
                tex_address_mode clamp
                filtering none
            }
		}
	}
}
