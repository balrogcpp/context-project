fragment_program gtao glsl glsles vk
{
	source gtao.frag
	default_params
	{
		//param_named_auto Time time
	}
}

fragment_program tolinear glsl glsles vk
{
	source tolinear.frag
}

fragment_program normals glsl glsles vk
{
	source normals.frag
}

fragment_program denoiser glsl glsles vk
{
	source denoiser.frag
}

fragment_program gtaotemporaldenoiser glsl glsles vk
{
	source gtaotemporaldenoiser.frag
	default_params
	{
		//param_named_auto FrameTime frame_time 1
	}
}

fragment_program gtaocombine glsl glsles vk
{
	source gtaocombine.frag
}
