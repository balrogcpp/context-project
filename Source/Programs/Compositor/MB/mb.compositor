import STD from mrt.compositor

compositor MB : STD
{
    technique
    {
        target_output
        {
            pass render_quad
            {
                //quad_normals camera_far_corners_view_space
                identifier 30
                material MB
                input 0 rt
                input 1 mrt 1
            }
        }
    }
}
