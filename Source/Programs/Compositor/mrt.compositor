// created by Andrey Vasiliev

//----------------------------------------------------------------------------------------------------------------------
// STD
//----------------------------------------------------------------------------------------------------------------------
abstract compositor STD
{
    technique
    {
        compositor_logic DeferredLogic

        texture_ref mrt MRT mrt
        texture rt target_width target_height PF_FLOAT16_RGB no_fsaa depth_pool 0 pooled

        target rt
        {
            input previous
        }
    }
}


//----------------------------------------------------------------------------------------------------------------------
// Abstract node to avoid copy & paste
//----------------------------------------------------------------------------------------------------------------------
abstract target env_target
{
    shadows off
    only_initial on

    pass clear {}
    pass render_scene
    {
        last_render_queue 95
        camera CubeCamera align_to_face
    }
}

abstract target skybox_target
{
    shadows off
    //only_initial on

    pass clear {}
    pass render_scene
    {
        first_render_queue 90
        last_render_queue 90
        camera CubeCamera align_to_face
    }
}

compositor MRT
{
    technique
    {
        compositor_logic DeferredLogic

        texture mrt target_width target_height PF_FLOAT16_RGB PF_DEPTH24_STENCIL8 no_fsaa depth_pool 1 chain_scope
        texture rt0 target_width_scaled 0.5 target_height_scaled 0.5 PF_R11G11B10_FLOAT no_fsaa depth_pool 0
        texture rt1 target_width_scaled 0.5 target_height_scaled 0.5 PF_FLOAT16_R no_fsaa depth_pool 0
        texture reflection target_width_scaled 0.25 target_height_scaled 0.25 PF_R11G11B10_FLOAT no_fsaa depth_pool 1

        texture ssao target_width_scaled 0.5 target_height_scaled 0.5 PF_FLOAT16_R no_fsaa depth_pool 0
        texture ao target_width_scaled 0.5 target_height_scaled 0.5 PF_FLOAT16_R no_fsaa depth_pool 0
        texture cube 256 256 PF_R11G11B10_FLOAT cubic no_fsaa depth_pool 0
        texture skybox 1024 1024 PF_R11G11B10_FLOAT cubic no_fsaa depth_pool 0

        target cube 0 : skybox_target {}
        target cube 1 : skybox_target {}
        target cube 2 : skybox_target {}
        target cube 3 : skybox_target {}
        target cube 4 : skybox_target {}
        target cube 5 : skybox_target {}

        //target cube 0 : env_target {}
        //target cube 1 : env_target {}
        //target cube 2 : env_target {}
        //target cube 3 : env_target {}
        //target cube 4 : env_target {}
        //target cube 5 : env_target {}

        target reflection
        {
            shadows off
            pass clear {}
            //pass render_custom PlanarReflectionPass {}
            pass render_scene { last_render_queue 90 }
        }

        target mrt
        {
            shadows off
            pass clear {}
			pass render_scene
            {
                material_scheme gbuffer
                last_render_queue 90
            }
        }

        target rt1
        {
            pass render_quad
            {
                identifier 10
                material ToLinear
                input 0 mrt 1
            }
        }

        target ssao
        {
            pass render_quad
            {
                material GTAO
                input 0 rt1
            }
        }

        target ao
        {
            pass render_quad
            {
                material Denoiser
                input 0 ssao
            }
        }

        target mrt
        {
            pass render_scene
            {
                last_render_queue 90
            }
        }

        target rt0
        {
            pass render_quad
            {
                material Copy2x
                input 0 mrt
            }
        }

        target mrt
        {
            shadows off
            pass render_scene
            {
                first_render_queue 95
            }
        }
    }
}

compositor ShowDepth : STD
{
    technique
    {
        target_output
        {
            pass render_quad
            {
                material Copyback
                input 0 mrt 1
            }
        }
    }
}

compositor ShowNormals : STD
{
    technique
    {
        target_output
        {
            pass render_quad
            {
                identifier 10
                material Normals
                input 0 mrt 1
            }
        }
    }
}

compositor ShowOcclusion : STD
{
    technique
    {
        texture_ref ao MRT ao

        target_output
        {
            pass render_quad
            {
                material Debug
                input 0 ao
            }
        }
    }
}

compositor Copyback : STD
{
    technique
    {
        target_output
        {
            pass render_quad
            {
                material Copyback
                input 0 mrt
            }
        }
    }
}
