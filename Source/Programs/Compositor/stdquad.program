// created by Andrey Vasiliev

vertex_program StdQuad glsl glsles vk
{
	source stdquad.vert
}

vertex_program RayCast glsl glsles vk
{
	source raycast.vert
}

fragment_program Copy glsl glsles vk
{
	source copy.frag
}

fragment_program Copyback glsl glsles vk
{
	source copyback.frag

    default_params
    {
        param_named_auto ViewportSize viewport_size
    }
}

fragment_program Copy2x glsl glsles vk
{
	source copy2x.frag
}

fragment_program max4 glsl glsles vk
{
	source max4.frag
}

fragment_program Debug glsl glsles vk
{
	source debug.frag
}
